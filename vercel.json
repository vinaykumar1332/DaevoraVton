{
  "rewrites": [
    { "source": "/api/render/:path*", "destination": "/api/render?path=:path*" },
    { "source": "/api/assist/:path*", "destination": "/api/assist?path=:path*" },
    { "source": "/cdn/:path*", "destination": "https://cdn.fashn.ai/:path*" },
    { "source": "/media/:path*", "destination": "https://media.fashn.ai/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/*.js": { "maxDuration": 120 },
    "api/chat/*.js": { "maxDuration": 120 },
    "api/job/*.js": { "maxDuration": 120 },
    "api/photo/*.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://vercel.live; font-src 'self' https://fonts.gstatic.com https://vercel.live https://assets.vercel.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss://ws-us3.pusher.com; frame-src https://vercel.live; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
