# Get your key at https://app.fashn.ai/api
# Read by vite.config.js only (server side). Never bundled into the browser code.
FASHN_API_KEY=fa-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Get it at https://platform.openai.com/api-keys
# Enables the "OpenAI image edit" workflow (gpt-image-1, via /openai proxy).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx


# ---- Local Express backend (optional) ----
# Uncomment to route API calls through the local Express backend (npm run server).
# The backend adds per-job timing metrics at http://localhost:3001/api/metrics.
# When this is set, run: npm run dev:full  (starts both frontend and backend together).
# BACKEND_PORT=3001

# ---- Sign-in (server side only, never VITE_-prefixed) ----
# JSON array of accounts. role is "admin" or "viewer". Keep this on ONE line.
APP_USERS=[{"username":"admin","password":"change-me-to-a-long-password","role":"admin","name":"Admin"}]
# Random string, 32+ characters. Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
