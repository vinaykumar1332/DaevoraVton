{
  "_about": "Evaluation cases. Image paths are placeholders: replace them with real photos in eval/images/. 'assumed' is what the vision model is expected to say for each photo, used by the offline check. 'expect.rules' are regular expressions that must match the engine prompt.",
  "cases": [
    {
      "id": "saree-on-model",
      "title": "Saree on a model",
      "inputs": [
        {
          "file": "eval/images/saree-model.jpg",
          "role": "model"
        },
        {
          "file": "eval/images/saree.jpg",
          "role": "garment"
        }
      ],
      "userText": "Dress the model in the saree.",
      "prompt": "The model wears the saree from image 2.",
      "usePhotos": [
        1,
        2
      ],
      "usePrevious": false,
      "outputView": "front",
      "styling": {},
      "assumed": [
        {
          "photo": 1,
          "role": "model",
          "view": "front",
          "framing": "full"
        },
        {
          "photo": 2,
          "role": "garment",
          "view": "front",
          "length": "full",
          "fabric": "silk"
        }
      ],
      "expect": {
        "rules": [
          "Keep the framing of the model photo",
          "Keep the pose of the person exactly"
        ]
      }
    },
